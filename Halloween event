-- Server hop logic
local HopTeleportStarted = false
local HopPending = false
local HopPendingToken = 0
local HopLastJob = nil

function HopCancelPending(reason)
    if not HopPending then return false end
    HopPendingToken = HopPendingToken + 1
    HopPending = false
    getgenv().IsServerHopping = false
    Notify("Server Hop", reason or "Server hop cancelled", 3)
    return true
end

function FetchServerList()
    local url = "https://games.roblox.com/v1/games/" .. game.PlaceId
        .. "/servers/Public?sortOrder=Desc&excludeFullGames=true&limit=100"
    local ok, res = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(url))
    end)
    if ok and type(res) == "table" and type(res.data) == "table" then
        return res.data
    end
    return nil
end

function PickServer(servers, random)
    if random then
        local shuffled = {}
        for i, server in ipairs(servers) do shuffled[i] = server end
        for i = #shuffled, 2, -1 do
            local j = math.random(i)
            shuffled[i], shuffled[j] = shuffled[j], shuffled[i]
        end
        servers = shuffled
    end
    local function scan(minPlayers)
        for _, s in ipairs(servers) do
            local id = s.id and tostring(s.id)
            local playing = tonumber(s.playing) or 0
            local maxPlayers = tonumber(s.maxPlayers) or 12
            if id and id ~= game.JobId and id ~= HopLastJob
                and playing >= minPlayers and playing < maxPlayers then
                return id
            end
        end
        return nil
    end
    return scan(random and 0 or (tonumber(_G.HopMinPlayers) or 7)) or scan(2)
end

-- Auto execute after hop
function HopQueueAutoExec()
    if _G.AutoExecute ~= true then return false end
    local fn = GetQueueOnTeleport()
    if type(fn) ~= "function" then return false end
    return pcall(fn, ScriptLoadstring)
end

-- Teleport state monitor
pcall(function()
    LocalPlayer.OnTeleport:Connect(function(state)
        if state == Enum.TeleportState.Started then
            HopTeleportStarted = true
        end
    end)
end)

local HopDelay = 5

function HopCountdownLabel(seconds)
    return "Hop countdown: " .. tostring(seconds or HopDelay) .. " seconds"
end

function HopToJob(jobId, message, delay, watchdog)
    if type(jobId) ~= "string" or jobId == "" then return false end
    if HopPending then return false end
    local waitTime = tonumber(delay) or HopDelay
    HopPendingToken = HopPendingToken + 1
    local token = HopPendingToken
    HopPending = true
    HopTeleportStarted = false
    HopLastJob = jobId
    getgenv().IsServerHopping = true
    getgenv().ServerHopAt = tick()
    local suffix = ""
    if waitTime > 0 then suffix = " · " .. HopCountdownLabel(waitTime) end
    Notify("Server Hop", (message or ("Hopping to " .. jobId:sub(1, 8))) .. suffix, math.max(1, waitTime))
    task.spawn(function()
        local deadline = tick() + waitTime
        while true do
            if HopPendingToken ~= token or getgenv().IsServerHopping == false then
                HopPending = false
                return
            end
            local left = deadline - tick()
            if left <= 0 then break end
            task.wait(math.min(left, 0.25))
        end
        HopPending = false
        if HopPendingToken ~= token then return end
        HopQueueAutoExec()
        local ok = pcall(function()
            local remote = RS:FindFirstChild("__ServerBrowser") or RS:WaitForChild("__ServerBrowser", 3)
            if remote then
                remote:InvokeServer("teleport", jobId)
            else
                TeleportService:TeleportToPlaceInstance(game.PlaceId, jobId, LocalPlayer)
            end
        end)
        if not ok then
            getgenv().IsServerHopping = false
            Notify("Server Hop", "Server hop teleport failed", 4)
        end
    end)
    return true
end

function HopServer(force, immediate, random)
    if not force then
        getgenv().IsServerHopping = false
        return
    end
    local now = tick()
    if getgenv().IsServerHopping and getgenv().ServerHopAt and (now - getgenv().ServerHopAt) > 45 then
        getgenv().IsServerHopping = false
    end
    if getgenv().IsServerHopping then return end
    getgenv().IsServerHopping = true
    getgenv().ServerHopAt = now
    local servers = FetchServerList()
    if not servers then
        getgenv().IsServerHopping = false
        Notify("Server Hop", "Could not fetch the server list", 3)
        return
    end
    local target = PickServer(servers, random)
    if not target then
        target = PickServer(servers, random)
    end
    if not target then
        getgenv().IsServerHopping = false
        Notify("Server Hop", "No available servers found", 5)
        return
    end
    return HopToJob(target, "Hopping to " .. target, immediate and 0 or HopDelay, immediate == true)
end

