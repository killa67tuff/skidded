        local roots = {}
        pcall(function() roots[#roots + 1] = game:GetService("CoreGui") end)
        pcall(function() roots[#roots + 1] = LocalPlayer:FindFirstChildOfClass("PlayerGui") end)
        for _, root in ipairs(roots) do
            if root then
                for _, item in ipairs(root:GetDescendants()) do
                    if (item:IsA("TextButton") or item:IsA("TextLabel"))
                        and (item.Text == "Language" or item.Text == "Langue") then
                        local node = item
                        for _ = 1, 4 do
                            if not node or not node.Parent then break end
                            if node:IsA("GuiButton") then
                                pcall(function() node:Activate() end)
                                return
                            end
                            node = node.Parent
                        end
                    end
                end
            end
        end
    end)
end, 1)

