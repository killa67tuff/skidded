local StatusGui = nil
local StatusTitle, StatusLine1, StatusLine2 = nil, nil, nil
local StatusDragging, StatusDragOffset = false, nil

local function Status_FormatClock(secondsOfDay)
    secondsOfDay = math.floor(secondsOfDay) % 86400
    local h = math.floor(secondsOfDay / 3600)
    local m = math.floor(secondsOfDay / 60) % 60
    local s = secondsOfDay % 60
    return string.format("%02d:%02d:%02d", h, m, s)
end

local function Status_FormatCountdown(seconds)
    seconds = math.max(0, math.floor(seconds))
    return string.format("%02d:%02d", math.floor(seconds / 60), seconds % 60)
end

local function Status_Build()
    if StatusGui then return end
    local gui = Instance.new("ScreenGui")
    gui.Name = "AutoEventStatus"
    gui.ResetOnSpawn = false
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    local ok = pcall(function() gui.Parent = game:GetService("CoreGui") end)
    if not ok then
        gui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    end

    local frame = Instance.new("Frame")
    frame.Name = "StatusFrame"
    frame.Size = UDim2.new(0, 240, 0, 64)
    frame.Position = UDim2.new(1, -252, 0, 12)
    frame.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
    frame.BackgroundTransparency = 0.25
    frame.BorderSizePixel = 0
    frame.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = frame

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(120, 90, 200)
    stroke.Thickness = 1
    stroke.Transparency = 0.4
    stroke.Parent = frame

    local title = Instance.new("TextLabel")
    title.Name = "Title"
    title.Size = UDim2.new(1, -12, 0, 20)
    title.Position = UDim2.new(0, 6, 0, 4)
    title.BackgroundTransparency = 1
