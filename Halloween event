local DragonGetUpval = (debug and debug.getupvalue) or getupvalue
local DragonSetupval = (debug and debug.setupvalue) or setupvalue
local DragonGetUpvals = (debug and debug.getupvalues) or getupvalues

local DragonShootFunction = nil
local DragonVIdx = { v26 = 12, v22 = 13, v25 = 14, v21 = 15, v23 = 16, v24 = 17, v27 = 18 }
local DragonMissingNotified = false

local function Dragon_Init()
    if DragonShootFunction then return end
    if not DragonGetUpval then return end
    local controllers = RS:FindFirstChild("Controllers")
    if not controllers then return end
    local ok, controller = pcall(require, controllers:WaitForChild("CombatController", 10))
    if ok and type(controller) == "table" and controller.Attack then
        local fn = DragonGetUpval(controller.Attack, 9)
        if type(fn) == "function" then
            DragonShootFunction = fn
        end
    end
end

local function Dragon_GetNextValidator()
    if not DragonShootFunction then Dragon_Init() end
    if not DragonShootFunction or not DragonGetUpval or not DragonGetUpvals then return 0, 0 end
    local v = DragonGetUpvals(DragonShootFunction)
    if not v then return 0, 0 end

    if v[DragonVIdx.v21] ~= 727595 then
        for k, v2 in pairs(v) do
            if v2 == 727595 then
                local n3 = k - 15
                DragonVIdx.v21 = k
                DragonVIdx.v22 = 13 + n3
                DragonVIdx.v23 = 16 + n3
                DragonVIdx.v24 = 17 + n3
                DragonVIdx.v26 = 12 + n3
                DragonVIdx.v25 = 14 + n3
                DragonVIdx.v27 = 18 + n3
                break
            end
        end
    end

    local v2 = DragonGetUpval(DragonShootFunction, DragonVIdx.v21)
    local v3 = DragonGetUpval(DragonShootFunction, DragonVIdx.v22)
    local v4 = DragonGetUpval(DragonShootFunction, DragonVIdx.v23)
    local v5 = DragonGetUpval(DragonShootFunction, DragonVIdx.v24)
    local v6 = DragonGetUpval(DragonShootFunction, DragonVIdx.v25)
    local v7 = DragonGetUpval(DragonShootFunction, DragonVIdx.v26)
    local v8 = DragonGetUpval(DragonShootFunction, DragonVIdx.v27)
    if not (v2 and v3 and v4 and v5 and v6 and v7 and v8) then
        return 0, 0
    end
    local n3 = ((v6 * v3 + v7 * v2) % v4 * v4 + v7 * v3) % v5
    local n4 = math.floor(n3 / v4)
    local n5 = v8 + 1
    DragonSetupval(DragonShootFunction, DragonVIdx.v25, n4)
    DragonSetupval(DragonShootFunction, DragonVIdx.v26, n3 - n4 * v4)
    DragonSetupval(DragonShootFunction, DragonVIdx.v27, n5)
    return math.floor(n3 / v5 * 16777215), n5
end

local function Dragon_Shoot(part)
    if not part then return end
    local v, v2 = Dragon_GetNextValidator()
    if v ~= 0 and DragonValidator2 then
        pcall(function() DragonValidator2:FireServer(v, v2) end)
    end
    if DragonShootEvent then
        pcall(function() DragonShootEvent:FireServer(part.Position, { part }) end)
    end
end

