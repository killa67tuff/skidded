-- Whether the hourly event currently owns execution (XX:00~XX:10 with auto hourly event on)
function Halloween.EventOwns()
    return Halloween.InWindow() and Halloween.Auto()
end

-- Whether pumpkin farming must yield (hourly event window or pumpkin boss taking over)
function Halloween.PumpkinYield()
