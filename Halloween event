local function WebhookInventorySnapshot()
    local ok, inventory = pcall(CommF.InvokeServer, CommF, "getInventory")
    if not ok or type(inventory) ~= "table" then return nil end
    local snapshot = {}
    for _, entry in pairs(inventory) do
        if type(entry) == "table" and type(entry.Name) == "string" then
            local count = tonumber(entry.Count) or 1
            snapshot[entry.Name] = (snapshot[entry.Name] or 0) + count
        end
    end
    return snapshot
end

local function WebhookDropLines(before, after)
    if type(before) ~= "table" or type(after) ~= "table" then return nil end
    local lines = {}
    for itemName, count in pairs(after) do
        local previous = before[itemName] or 0
        if count > previous then
            local gained = count - previous
            lines[#lines + 1] = itemName .. (gained > 1 and (" x" .. tostring(gained)) or "")
        end
    end
    table.sort(lines)
    return lines
end

local function WebhookBossTick()
    local now = tick()
    for bossName, info in pairs(WebhookBossList) do
        local state = WebhookBossState[bossName]
        if state then
            local model = state.Model
            local alive = model ~= nil and model:IsDescendantOf(Workspace)
            local humanoid = alive and model:FindFirstChildOfClass("Humanoid")
            if humanoid then state.Health = humanoid.Health end
            local dead = (not alive) or (humanoid ~= nil and humanoid.Health <= 0)
                or (state.Health ~= nil and state.Health <= 0)
            if dead then
                WebhookBossState[bossName] = nil
                WebhookBossReadyAt[bossName] = now + 10
                if _G.WebhookBoss then
                    local captured = state
                    local name, config = bossName, info
                    task.spawn(function()
                        -- Give the server a moment to grant the drops
                        task.wait(2)
                        local lines = nil
                        if captured.Snapshot then
                            lines = WebhookDropLines(captured.Snapshot, WebhookInventorySnapshot())
                        end
                        Webhook.SendBossKill(name, config.Color, lines, config.Possible)
                    end)
                end
            end
        elseif now >= (WebhookBossReadyAt[bossName] or 0) then
            local model = Workspace:FindFirstChild(bossName, true)
            if model and model:IsA("Model") then
                local humanoid = model:FindFirstChildOfClass("Humanoid")
                if not humanoid or humanoid.Health > 0 then
                    local snapshot = WebhookInventorySnapshot()
                    WebhookBossState[bossName] = {
                        Model = model,
                        Snapshot = snapshot,
                        Health = humanoid and humanoid.Health,
                    }
                    if _G.WebhookBoss then
                        Webhook.SendBossSpawn(bossName, info.Color)
                    end
                end
            end
        end
    end
end

