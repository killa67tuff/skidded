                if model ~= character then
                    local aim = model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")
                    if aim then
                        local hp = GetMobHealth(model)
                        if hp and hp > 0 and (aim.Position - origin).Magnitude <= 120 then
                            hitList[#hitList + 1] = { model, aim, (aim.Position - origin).Magnitude }
                        end
                    end
                end
            end
        end
    end
    table.sort(hitList, function(a, b) return a[3] < b[3] end)
    if #hitList > 8 then
        local trimmed = {}
        for i = 1, 8 do trimmed[i] = hitList[i] end
        return trimmed
    end
    return hitList
end

