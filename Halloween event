    end
    if _G.DragonstormAura and type(Dragon_Owned) == "function" and Dragon_Owned() then
        local char = LocalPlayer.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        if not tool or tool.Name ~= "Dragonstorm" then
