        ["Spike-Spike"]         = { name = "Spike Fruit",         rarity = "common" },
        ["Smoke-Smoke"]         = { name = "Smoke Fruit",         rarity = "common" },
        ["Bomb-Bomb"]           = { name = "Bomb Fruit",          rarity = "common" },
        ["Spring-Spring"]       = { name = "Spring Fruit",        rarity = "common" },
        ["Blade-Blade"]         = { name = "Blade Fruit",         rarity = "common" },
        ["Spin-Spin"]           = { name = "Spin Fruit",          rarity = "common" },
        ["Rocket-Rocket"]       = { name = "Rocket Fruit",        rarity = "common" },
    }

    local FruitByName = {}
    local function BuildLookupKey(raw)
        if type(raw) ~= "string" then return nil end
        local key = string.lower(raw)
        key = string.gsub(key, "fruit", "")
        key = string.gsub(key, "[%s_%-%(%)]", "")
        return key
    end

    for id, data in pairs(FruitList) do
        FruitByName[BuildLookupKey(id)] = data
        FruitByName[BuildLookupKey(data.name)] = data
    end

    local function FruitRarity(fruitName)
        if type(fruitName) ~= "string" or fruitName == "" then return nil end
        for _, data in pairs(FruitList) do
            if data.name == fruitName then return data.rarity end
        end
        local key = BuildLookupKey(fruitName)
        if key and FruitByName[key] then return FruitByName[key].rarity end
        local prefix = string.match(fruitName, "^([^%-]+)")
        if prefix then
            local pkey = BuildLookupKey(prefix)
            if pkey and FruitByName[pkey] then return FruitByName[pkey].rarity end
        end
        return nil
    end

    -- Halloween 2026 event items with a known rarity (Spooky Gacha pool)
    local EventItemRarity = {
        ["Coven Witch Hat"] = "Mythical",
        ["Pumpkin Mask"] = "Mythical",
        ["Mummy Headdress"] = "Mythical",
        ["Great Pumpkin Top Hat"] = "Mythical",
    }

    function Webhook.ItemRarity(itemName)
        if type(itemName) ~= "string" then return nil end
        return FruitRarity(itemName) or EventItemRarity[itemName]
    end

    function Webhook.RaritySelected(rarity)
        if type(rarity) ~= "string" then return false end
        for _, selected in ipairs(_G.PingRarities or {}) do
            if Webhook.NormalizeRarity(selected) == rarity then return true end
        end
        return false
    end

    -- Local display map: keeps rarity words out of the global translation table
    local function RarityText(rarity)
        if _G.Language == "French" then
            local french = {
                ["Mythical"] = "Mythique",
                ["Legendary"] = "Légendaire",
                ["rare"] = "rare",
                ["uncommon"] = "peu commun",
                ["common"] = "commun",
            }
            return french[rarity] or rarity
        end
        return rarity
    end

    local function ServerTimeText()
        local stamp = os.time()
        pcall(function() stamp = math.floor(Workspace:GetServerTimeNow()) end)
        return os.date("%Y-%m-%d %H:%M:%S", stamp)
    end

    local function FitValue(text, limit)
        text = tostring(text or "")
        if #text > limit then
            return string.sub(text, 1, limit - 16) .. "\n..."
        end
        return text
    end

    -- Core sender: title / description / field names go through L() at send time
    function Webhook.Send(opts)
        local url = _G.WebhookUrl
        if type(url) ~= "string" or url == "" then return end
        if not WebhookRequest then return end

        local content, parse = "", {}
        if opts.Ping and _G.WebhookPing then
            local uid = string.match(tostring(_G.WebhookPingId or ""), "%d+")
            if uid then
                content, parse = "<@" .. uid .. ">", { "users" }
            else
                content, parse = "@everyone", { "everyone" }
            end
        end

        local fields = {}
        for _, field in ipairs(opts.Fields or {}) do
            fields[#fields + 1] = {
                name = FitValue(L(tostring(field.name or "")), 256),
                value = FitValue(field.value, 1000),
                inline = field.inline ~= false,
            }
        end
        if #fields == 0 then
            fields[1] = { name = L("Server Time"), value = ServerTimeText(), inline = true }
        end

        local embed = {
            color = opts.Color or 0x7F00FF,
            fields = fields,
            footer = { text = "Auto Event | " .. ServerTimeText() },
        }
        if opts.Title then
            embed.title = FitValue(L(tostring(opts.Title)), 256)
        end
        if opts.Description then
            embed.description = FitValue(L(tostring(opts.Description)), 4000)
        end

        local payload = {
            username = "Auto Event",
            content = content,
            embeds = { embed },
        }
        if content ~= "" then
            payload.allowed_mentions = { parse = parse }
        end

        pcall(function()
            WebhookRequest({
                Url = url,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode(payload),
            })
        end)
    end

    function Webhook.SendEvent(started)
        local window = "XX:00 - XX:" .. string.format("%02d", (Halloween and Halloween.WindowMinutes) or 10)
        Webhook.Send({
            Title = started and "Halloween Event Started" or "Halloween Event Ended",
            Description = started and "The hourly Halloween event window is now open"
                or "The hourly Halloween event window has closed",
            Color = started and 0x2ECC71 or 0xE74C3C,
            Fields = {
                { name = "Event Window", value = window, inline = true },
            },
            Ping = true,
        })
    end

    function Webhook.SendBossSpawn(bossName, color)
        Webhook.Send({
            Title = "Boss Spawned",
            Color = color,
            Fields = {
                { name = "Boss", value = bossName, inline = true },
                { name = "Server Time", value = ServerTimeText(), inline = true },
            },
            Ping = true,
        })
    end

    function Webhook.SendBossKill(bossName, color, dropLines, possible)
        local fields = {
            { name = "Boss", value = bossName, inline = true },
        }
        local description = nil
        if dropLines and #dropLines > 0 then
            fields[#fields + 1] = { name = "Drops", value = table.concat(dropLines, "\n"), inline = false }
        else
            description = "No drop detected in the inventory"
            local list = {}
            for _, item in ipairs(possible or {}) do list[#list + 1] = tostring(item) end
            if #list == 0 then list[1] = "?" end
            fields[#fields + 1] = { name = "Possible Drops", value = table.concat(list, ", "), inline = false }
        end
        Webhook.Send({
            Title = "Boss Killed",
            Description = description,
            Color = color,
            Fields = fields,
            Ping = true,
        })
    end

    function Webhook.SendGacha(itemName, rarity)
        local fields = {
            { name = "Item", value = itemName, inline = true },
        }
        if rarity then
            fields[#fields + 1] = { name = "Rarity", value = RarityText(rarity), inline = true }
        end
        Webhook.Send({
            Title = "Gacha Result",
            Color = 0x7F00FF,
            Fields = fields,
            Ping = rarity ~= nil and Webhook.RaritySelected(rarity),
        })
    end

    -- Pull result may be a plain item name or a table holding it
    function Webhook.GachaItem(result)
        if type(result) == "string" then
            if result ~= "" then return result end
            return nil
        end
        if type(result) == "table" then
            for _, key in ipairs({ "Name", "Item", "ItemName", "Fruit", "Reward", "Prize", "Result", "Product" }) do
                local value = result[key]
                if type(value) == "string" and value ~= "" then return value end
                if type(value) == "table" and type(value.Name) == "string" and value.Name ~= "" then
                    return value.Name
                end
            end
            for _, key in ipairs({ "Data", "Info" }) do
                local nested = result[key]
                if type(nested) == "table" and type(nested.Name) == "string" and nested.Name ~= "" then
                    return nested.Name
                end
            end
        end
        return nil
    end
end

