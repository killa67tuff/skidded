            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local pos = Vector2.new(input.Position.X, input.Position.Y) + StatusDragOffset
        frame.Position = UDim2.new(0, math.clamp(pos.X, 0, math.max(0, gui.AbsoluteSize.X - frame.AbsoluteSize.X)),
            0, math.clamp(pos.Y, 0, math.max(0, gui.AbsoluteSize.Y - frame.AbsoluteSize.Y)))
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            StatusDragging = false
        end
    end)

    StatusGui = gui
    StatusTitle, StatusLine1, StatusLine2 = title, line1, line2
