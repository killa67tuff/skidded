L = function(text)
    if type(text) ~= "string" or _G.Language ~= "French" then return text end
    local state = TranslationState
    if not state.Index then
        state.Index = {}
        for en, fr in pairs(state.Translations.French) do state.Index[#state.Index + 1] = { en = en, fr = fr } end
        table.sort(state.Index, function(x, y) return #x.en > #y.en end)
        state.Cache = {}
    end
    local cached = state.Cache[text]
    if cached ~= nil then return cached end
    local exact = state.Translations.French[text]
    local result = exact or text
    if not exact then
        for _, entry in ipairs(state.Index) do
            if entry.en ~= "" and string.find(result, entry.en, 1, true) then
                local escaped = entry.en:gsub("([%^%$%(%)%%%.%[%]%*%+%-%?])", "%%%1")
                result = string.gsub(result, escaped, function() return entry.fr end)
            end
        end
    end
    state.Cache[text] = result
    return result
end

local ReverseTranslationIndex
local ReverseTranslationCache = {}

local function TranslateToEnglish(text)
    if type(text) ~= "string" then return text end
    local cached = ReverseTranslationCache[text]
    if cached ~= nil then return cached end
    if not ReverseTranslationIndex then
        ReverseTranslationIndex = {}
        for en, fr in pairs(TranslationState.Translations.French) do
            if type(fr) == "string" and fr ~= "" then
                ReverseTranslationIndex[#ReverseTranslationIndex + 1] = { fr = fr, en = en }
            end
        end
        table.sort(ReverseTranslationIndex, function(a, b) return #a.fr > #b.fr end)
    end
    local result = text
    for _, entry in ipairs(ReverseTranslationIndex) do
        if string.find(result, entry.fr, 1, true) then
            local escaped = entry.fr:gsub("([^%w])", "%%%1")
            result = string.gsub(result, escaped, function() return entry.en end)
        end
    end
    ReverseTranslationCache[text] = result
    return result
end

local function TranslateParts(text)
    if type(text) ~= "string" then return text end
    return L(text)
end

TranslationState.RefreshVisibleLanguage = function()
    local roots = {}
    pcall(function() roots[#roots + 1] = game:GetService("CoreGui") end)
    pcall(function() roots[#roots + 1] = LocalPlayer:FindFirstChildOfClass("PlayerGui") end)
    for _, root in ipairs(roots) do
        if root then
            for _, gui in ipairs(root:GetDescendants()) do
                if gui:IsA("ScreenGui") then
                    local name = string.lower(gui.Name)
                    if string.find(name, "wind", 1, true) or string.find(name, "xu", 1, true)
                        or string.find(name, "liquidglass", 1, true) then
                        for _, item in ipairs(gui:GetDescendants()) do
                            if item:IsA("TextLabel") or item:IsA("TextButton") or item:IsA("TextBox") then
                                pcall(function()
                                    item.Text = _G.Language == "French" and TranslateParts(item.Text) or TranslateToEnglish(item.Text)
                                end)
                                if item:IsA("TextBox") then
                                    pcall(function()
                                        item.PlaceholderText = _G.Language == "French" and TranslateParts(item.PlaceholderText) or TranslateToEnglish(item.PlaceholderText)
                                    end)
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

