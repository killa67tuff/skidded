local function Status_Update()
    if not StatusGui or not StatusGui.Parent then return end
    local now = Workspace:GetServerTimeNow()
    local intoHour = now % 3600
    local remaining
    if intoHour < 600 then
        remaining = L("Event live: ends in ") .. Status_FormatCountdown(600 - intoHour)
    else
        remaining = L("Next event in ") .. Status_FormatCountdown(3600 - intoHour)
    end
    pcall(function()
        StatusTitle.Text = L("Status")
        StatusLine1.Text = L("Server Time: ") .. Status_FormatClock(now % 86400)
        StatusLine2.Text = remaining
    end)
end

function ApplyStatusPanel()
    if not _G.StatusPanel then
        if StatusGui then
            StatusGui:Destroy()
            StatusGui, StatusTitle, StatusLine1, StatusLine2 = nil, nil, nil, nil
        end
        return
    end
    Status_Build()
    Status_Update()
end

task.spawn(function()
    while true do
        if _G.StatusPanel then
            pcall(Status_Update)
        end
        task.wait(0.5)
    end
end)

pcall(ApplyStatusPanel)

function DestroyStatusPanel()
    if StatusGui then
        pcall(function() StatusGui:Destroy() end)
        StatusGui, StatusTitle, StatusLine1, StatusLine2 = nil, nil, nil, nil
    end
end

